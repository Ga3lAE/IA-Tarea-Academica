      "min": 0,
      "max": 100,
      "visible_if": { "jefe_ocupado": [1] },
      "unit": ["hora", "horas"]
    },
    "jefe_cat_ocupacional": {
      "type": "choice",
      "label": "En su trabajo principal, se desempeña como…",
      "visible_if": { "jefe_ocupado": [1] },
      "options": [
        { "value": 3, "label": "Empleada o empleado" },
        { "value": 4, "label": "Obrera u obrero" },
        { "value": 2, "label": "Independiente", "hint": "Trabaja por cuenta propia" },
        { "value": 1, "label": "Empleador o patrono", "hint": "Tiene trabajadores a su cargo" },
        { "value": 6, "label": "Trabajador del hogar" },
        { "value": 5, "label": "Familiar sin pago", "hint": "Ayuda en el negocio de un familiar" },
