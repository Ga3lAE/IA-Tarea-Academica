    "jefe_ocupado": {
      "type": "choice",
      "label": "La semana pasada, ¿la jefa o jefe del hogar trabajó?",
      "help": "Cuenta cualquier trabajo de al menos una hora: empleo, negocio propio o cachuelos. También si tiene empleo pero estuvo de vacaciones o con licencia.",
