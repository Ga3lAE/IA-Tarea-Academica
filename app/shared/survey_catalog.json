      "options": [
        { "value": 0, "label": "Sí, está afiliado" },
        { "value": 1, "label": "No está afiliado" }
      ]
    },
    "n_ocupados": {
      "type": "integer",
      "label": "En total, ¿cuántas personas del hogar trabajaron la semana pasada?",
      "help": "Incluye a la jefa o jefe si trabajó. Solo cuenta a personas de 14 años a más.",
      "min": 0,
      "max": 20,
      "unit": ["persona", "personas"]
    }
