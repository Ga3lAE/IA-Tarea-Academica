      "visible_if": { "jefe_ocupado": [1] },
      "hidden_if": { "jefe_cat_ocupacional": [6] },
      "options": [
        { "value": 1, "label": "Empresa privada formal", "hint": "S.A., S.R.L., E.I.R.L. u otra persona jurídica" },
        { "value": 2, "label": "Persona natural con RUC", "hint": "Incluye RUS o RER" },
        { "value": 3, "label": "Sin registro", "hint": "No tiene RUC" },
        { "value": 0, "label": "Entidad del Estado", "hint": "Ministerio, municipalidad, Fuerzas Armadas, Policía u otra institución pública" }
      ]
