        { "value": 1, "label": "Sí, trabajó" },
        { "value": 0, "label": "No trabajó" }
      ]
    },
    "jefe_horas_semanales": {
      "type": "integer",
      "label": "¿Cuántas horas trabajó la semana pasada en su trabajo principal?",
